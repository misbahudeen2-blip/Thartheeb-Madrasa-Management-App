{
  "name": "essl-push-server",
  "version": "1.0.0",
  "description": "Real-time HTTP push data capture server for eSSL/ZKTeco biometric devices",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "init-db": "node init-db.js",
    "build:exe": "pkg . -t node18-win-x64 --output Tartheeb-App.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  }
}
